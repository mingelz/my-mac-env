# zsh path 层入口
#
# 加载时机：zsh login shell（终端 App 新开窗口即是 login shell）
# 用途：构建 PATH，以及 brew shellenv、JAVA_HOME 等需要执行子进程的初始化
#
# 加载顺序：/etc/zshenv -> ~/.zshenv -> /etc/zprofile -> 【本文件】-> /etc/zshrc -> ~/.zshrc
# 之所以放在这一层，是因为 /etc/zprofile 会执行 path_helper 把系统路径重排到最前，
# 只有在其之后设置 PATH 才能保证优先级不被打乱。
#
# 非 login shell（如 Raycast script command、LaunchAgent 起的 `zsh -c`）不会读取本文件，
# 这类场景请显式使用 `zsh -l -c`。


# ------------------------------------------------------------------------------
# path 层加载
# ------------------------------------------------------------------------------

source "$HOME/.config/shell/path.sh"


# ------------------------------------------------------------------------------
# private 配置
# ------------------------------------------------------------------------------

# private*.path.sh: 私有的 PATH 配置（机器/内网专属，不进版本库）
for f in "$HOME"/.config/shell/private*.path.sh(N); do
  source "$f"
done


# ------------------------------------------------------------------------------
# 其他配置（当有应用修改此文件时可快速识别）
# ------------------------------------------------------------------------------
