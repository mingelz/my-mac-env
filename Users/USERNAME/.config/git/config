# 引入私人配置（user.name, user.email, proxy 等）
# 使用方法见 private_config.example
[include]
    path = private_config

[core]
    # 不追踪快捷方式
    symlinks = false
[credential]
    # 保存密码到 keychain，避免每次输入密码（仅适用于 macOS）
    helper = osxkeychain
[init]
    defaultBranch = master
[pager]
    # 从 git@2.16 开始 branch 使用 less 显示信息，不太习惯，改为传统方式
    branch = false

[diff]
    tool = vimdiff
[difftool]
    prompt = false
    # 通过 :cquit 可以退出 diff 队列
    trustExitCode = true
[difftool "vimdiff"]
    # 默认的 diff.tool = vimdiff 会导致添加 -R (只读) 参数，所以需要专门指定一下 cmd
    cmd = "vimdiff $LOCAL $REMOTE"
[merge]
    # merge 时只允许 Fast Forward 方式处理，否则建议使用 rebase
    #ff = only
[push]
    default = simple
[pull]
    # git pull 默认记录 merge 分叉，如果希望不分叉就使用后边定义的 pr 命令
    rebase = false
[status]
    # 未 git add 的目录，也显式列出其下的所有文件
    showUntrackedFiles = all

[alias]
    # -- branch --
    br = branch
    # 清理本地已合并的分支
    clean-merged = "!git branch --merged | grep -v '\\*\\|master\\|main' | xargs -n 1 git branch -d"

    # -- commit --
    ci = commit
    cim = commit -m
    cin = commit --no-verify -m

    # -- clone --
    cl = clone
    cl1 = clone --depth 1

    # -- checkout --
    cn = checkout -b
    co = checkout

    # -- cherry-pick --
    cp = cherry-pick

    # -- diff --
    di = difftool
    # diff 最后一次提交的内容
    dl = "!f() { rev=${1-HEAD}; git difftool $rev^ $rev; }; f"

    # -- fetch --
    fc = fetch -p

    # -- log --
    # http://git-scm.com/docs/git-log
    #        图形    简短hash        相对时间        装饰ref    30条 显示格式: %h 短哈希, %ar 相对提交时间, %s 提交说明, %an 作者, %d 引用信息, %n 换行
    lg = log --graph --abbrev-commit --relative-date --decorate -n30 --pretty=format:'%C(red)%h%C(reset) - %C(cyan)(%ar)%C(reset) - %C(white)%s%C(reset) %C(dim white)- <%an>%C(reset) %C(auto)%d%C(reset)'
    # 在 lg 的基础上，列出所有 branchs/stash 的分支情况，并把条数放大到 500
    la = lg --all -n500
    # 查看最近修改的文件
    last = log -1 --stat

    # -- merge --
    mg = merge

    # -- pull --
    # 添加 --rebase 参数，在 merge 的时候不会分叉
    pr = pull --rebase

    # -- push --
    # 强制 push，但会检查远程分支是否发生变更，比直接 --force 更安全
    pf = push --force-with-lease

    # -- rebase --
    # 使用交互式 rebase 工具压缩 git 提交（squash）
    ri = rebase -i

    # -- reset --
    # HEAD是指向当前版本的指针，HEAD^指向上个版本（与HEAD~1相同），HEAD^^指向上上个版本（与HEAD~2相同）
    # --soft保留修改及暂存记录，--mixed保留修改但取消暂存，--hard删除修改完全恢复文件
    # 撤销 commit 但保留暂存记录，撤销前先打印提交信息留痕
    undo = "!GIT_PAGER=cat git log -1 --pretty='%C(red)Undoing%C(reset): [%C(green)%h%C(reset)] %C(cyan)%s%C(reset)' && git reset --soft HEAD^"
    # 恢复刚才被 undo 撤销的提交
    redo = "!git reset --soft HEAD@{1}"

    # -- stash --
    # stash 列表也可以像 log 列表一下展示信息
    sl = stash list --abbrev-commit --pretty=format:'%C(magenta)%gd%C(reset) - %C(red)%h%C(reset) - %C(cyan)(%ai)%C(reset) - %C(white)%s%C(reset) %C(dim white)- <%an>%C(reset) %C(auto)%d%C(reset)'
    sp = stash pop
    # 暂存所有更改（包括未追踪的文件 -u），从 git@2.13 开始支持，命令格式 git stash push [-u] [-m <message>] [--] [<pathspec>...]
    ss = stash push -u -m

    # -- status --
    st = status

    # -- worktree --
    wt = worktree

    # -- 统计 --
    # 统计有哪些人提交过，及每人提交次数，更高级的统计请看本项目的 `usr/local/git-rank` 文件
    who = shortlog -sn --all --no-merges
