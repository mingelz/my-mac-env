{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "your-anthropic-auth-token",
    "ANTHROPIC_BASE_URL": "your-anthropic-base-url",
    "ANTHROPIC_MODEL": "claude-opus-4-6",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "claude-opus-4-6",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-opus-4-6",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_AUTOUPDATER": "1",
    "DISABLE_PROMPT_CACHING": "0"
  },
  "language": "chinese",
  "theme": "dark",
  "editorMode": "vim",
  "includeCoAuthoredBy": false,
  "includeGitInstructions": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "skipWebFetchPreflight": true,
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow":[
      "Bash(awk **)",
      "Bash(basename **)",
      "Bash(cat **)",
      "Bash(cd **)",
      "Bash(cp **)",
      "Bash(curl **)",
      "Bash(date **)",
      "Bash(diff **)",
      "Bash(dirname **)",
      "Bash(echo **)",
      "Bash(env **)",
      "Bash(find **)",
      "Bash(git **)",
      "Bash(go **)",
      "Bash(gradle **)",
      "Bash(grep **)",
      "Bash(head **)",
      "Bash(java **)",
      "Bash(jq **)",
      "Bash(ls **)",
      "Bash(make **)",
      "Bash(mkdir **)",
      "Bash(mv **)",
      "Bash(mvn **)",
      "Bash(node **)",
      "Bash(npm **)",
      "Bash(npx **)",
      "Bash(open **)",
      "Bash(pbcopy **)",
      "Bash(pbpaste **)",
      "Bash(printenv **)",
      "Bash(pwd)",
      "Bash(python **)",
      "Bash(python3 **)",
      "Bash(realpath **)",
      "Bash(sed **)",
      "Bash(sort **)",
      "Bash(tail **)",
      "Bash(tar **)",
      "Bash(tee **)",
      "Bash(touch **)",
      "Bash(tree **)",
      "Bash(uname **)",
      "Bash(uniq **)",
      "Bash(unzip **)",
      "Bash(wc **)",
      "Bash(which **)",
      "Bash(whoami **)",
      "Bash(xargs **)",
      "Bash(xcodebuild **)",
      "Bash(xcrun **)",
      "Bash(zip **)",
      "Read(//tmp/**)",
      "Read(**/*.java)",
      "Read(**/*.py)",
      "Read(**/*.sh)",
      "Read(**/*.ts)",
      "Read(**/*.tsx)",
      "Edit(//tmp/**)",
      "Edit(**/*.java)",
      "Edit(**/*.py)",
      "Edit(**/*.sh)",
      "Edit(**/*.ts)",
      "Edit(**/*.tsx)",
      "WebFetch"
    ],
    "ask": [
      "Bash(brew install **)",
      "Bash(rm **)"
    ],
    "deny": [
      "Bash(git force-push)",
      "Bash(git force-push **)",
      "Bash(git push)",
      "Bash(git push **)",
      "Bash(npm publish)",
      "Bash(npm publish **)",
      "Bash(sudo **)",
      "Read(*.pem)",
      "Read(*.key)",
      "WebSearch"
    ]
  }
}
